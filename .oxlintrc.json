{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off",
    "nursery": "off"
  },
  "rules": {
    "eqeqeq": "warn",
    "no-console": "off",
    "no-underscore-dangle": "off",
    "no-unused-vars": "warn"
  },
  "overrides": [
    {
      "files": [
        "apps/core/app/lib/questions/server.ts",
        "apps/extensions/question-maker/app/backend/src/services/aiService.js",
        "apps/extensions/question-maker/app/backend/src/services/assessmentService.js",
        "apps/extensions/question-maker/app/backend/src/services/questionService.js"
      ],
      "rules": {
        "no-useless-catch": "warn"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/coverage/**",
    "**/generated/**",
    "**/.react-router/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/prisma/migrations/**",
    "eduai-design-system/**"
  ]
}
