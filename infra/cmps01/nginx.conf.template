# Public edge on :8001 — vLLM (LiteLLM) + internal research paths (single firewall port).
# Generated by deploy-edge-proxy.sh from nginx.conf.template + internal-allow.conf.
#
#   /v1/*     → LiteLLM on 127.0.0.1:18091 (Bearer via LiteLLM master_key)
#   /energy/* → energy-meter on 127.0.0.1:9100 (IP allowlist + X-EduAI-Internal-Key)
#   /ollama/* → Ollama on 127.0.0.1:11434 (IP allowlist + X-EduAI-Internal-Key)

map $http_x_eduai_internal_key $eduai_internal_key_ok {
    default 0;
    "${CMPS01_INTERNAL_KEY}" 1;
}

server {
    listen 8001;
    listen [::]:8001;
    server_name _;

    client_max_body_size 64m;
    proxy_read_timeout 600s;
    proxy_connect_timeout 60s;
    proxy_send_timeout 600s;

    location /energy/ {
        include /etc/nginx/conf.d/internal-allow.conf;

        if ($eduai_internal_key_ok = 0) {
            return 403;
        }

        proxy_pass http://127.0.0.1:9100/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /ollama/ {
        include /etc/nginx/conf.d/internal-allow.conf;

        if ($eduai_internal_key_ok = 0) {
            return 403;
        }

        proxy_pass http://127.0.0.1:11434/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 600s;
    }

    location / {
        proxy_pass http://127.0.0.1:18091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Content-Type $content_type;
    }
}
