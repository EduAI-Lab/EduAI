# cmps01 edge proxy — copy to .env on the GPU host (never commit .env).
# deploy-edge-proxy.sh reads this file to render nginx.conf + internal-allow.conf
# and litellm-config.runtime.yaml (LiteLLM master_key).

# Long random secret — also set BOTH of these on s378 apps/core/.env (not on laptops):
#   CMPS01_INTERNAL_KEY=<same>
#   VLLM_API_KEY=<same>   # LiteLLM /v1 bearer must match master_key
# Generate with: openssl rand -hex 32
# deploy-edge-proxy.sh REJECTS example placeholders (vllm-local, this example string, etc.).
CMPS01_INTERNAL_KEY=change-me-use-openssl-rand-hex-32

# Space-separated IPs allowed to reach /energy/ and /ollama/ (in addition to 127.0.0.1).
# Dev server only — do NOT add personal laptops or 0.0.0.0/0.
CMPS01_INTERNAL_ALLOW_IPS=206.87.25.229
