# Install with: sudo visudo -f /etc/sudoers.d/eduai-dev-bot
# (then: sudo chmod 0440 /etc/sudoers.d/eduai-dev-bot)
#
# Lets the ssaada08 account restart and check exactly the three system-level
# dev-server services that /dev-branch deploys manage. Nothing broader.

Cmnd_Alias EDUAI_DEV_RESTART = /usr/bin/systemctl restart eduai-core.service eduai-aitutor-server.service eduai-qm-backend.service, \
                                /usr/bin/systemctl --no-pager status eduai-core.service, \
                                /usr/bin/systemctl --no-pager status eduai-aitutor-server.service, \
                                /usr/bin/systemctl --no-pager status eduai-qm-backend.service

ssaada08 ALL=(root) NOPASSWD: EDUAI_DEV_RESTART
