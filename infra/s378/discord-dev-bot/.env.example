# Discord Developer Portal values. Never commit the real token or webhook URL.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# At least one user or role ID must be configured to use /dev-branch.
# Comma-separated Discord snowflake IDs are accepted.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_ROLE_IDS=

# The checkout and health endpoint on s378.
EDUAI_REPO=/srv/www/dev.eduai.ok.ubc.ca/EduAICore/EduAICore
EDUAI_HEALTH_URL=http://127.0.0.1:3000/
EDUAI_DEFAULT_BRANCH=development

# Optional: lets `npm run notify` report manual deployments without the bot.
DISCORD_WEBHOOK_URL=
