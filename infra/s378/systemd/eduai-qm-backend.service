[Unit]
Description=EduAI Question Maker API (dev.questionmaker → /api/ → :8000)
Documentation=file:///srv/www/dev.eduai.ok.ubc.ca/EduAICore/EduAICore/infra/s378/GO-LIVE.md
After=network-online.target
Wants=network-online.target
PartOf=eduai-dev.target

[Service]
Type=simple
User=ssaada08
Group=eduai-dev
UMask=0002

WorkingDirectory=/srv/www/dev.eduai.ok.ubc.ca/EduAICore/EduAICore/apps/extensions/question-maker/app/backend
EnvironmentFile=-/etc/eduai/eduai-dev.env
Environment=HOME=/home/ssaada08
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PORT=8000

# The `start` script also runs db:generate + db:migrate:deploy; both move to
# go-live-build.sh, so this execs the server directly. Keeping migrate out of the
# unit matters: Restart=always would re-run it on every crash-loop iteration.
ExecStart=/usr/local/bin/node src/index.js

Restart=always
RestartSec=5
TimeoutStartSec=90
KillMode=control-group

[Install]
WantedBy=eduai-dev.target
