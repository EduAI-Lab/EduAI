# Environment for the EduAI s378 system services.
# Installed to /etc/eduai/eduai-dev.env (root:eduai-dev, 0640) by
# go-live-systemd-install.sh.
# Do not put secrets here — apps load their own apps/*/.env files.

EDUAI_REPO=/srv/www/dev.eduai.ok.ubc.ca/EduAICore/EduAICore

# s378 is a DEVELOPMENT/staging box and must keep behaving like one, even though
# it now serves built assets rather than running `npm run dev`. This single
# variable drives both halves of that:
#
#   server-side  Core's `isProd` gates — HSTS and the strict nonce CSP stay off
#                (app/lib/security-headers.server.ts).
#   client-side  Vite derives `isProduction` from NODE_ENV, and
#                `import.meta.env.DEV` is `!isProduction`. go-live-build.sh
#                exports this into the build so the ~8 dev-only client branches
#                (error-boundary stacks, QM's /api-test route, local Canvas
#                defaults) survive bundling.
#
# Flipping this to production silently changes application behaviour on dev.
# `--mode development` is NOT an alternative — it was measured to be a no-op.
NODE_ENV=development
