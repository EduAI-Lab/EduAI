# Secret-free production Question Maker API environment.
# Install the completed file as /etc/eduai/eduai-qm.env; it is read by the
# systemd service on the host, not by Docker Compose.

NODE_ENV=production
PORT=8000
# Use a dedicated database/role on the host PostgreSQL instance. Do not reuse
# Core's database or the Docker-only `postgres` hostname.
DATABASE_URL=postgresql://<qm-user>:<database-password>@127.0.0.1:5432/<qm-database>?schema=public

CORE_URL=https://my.eduai.ok.ubc.ca
CORE_PUBLIC_ORIGIN=https://my.eduai.ok.ubc.ca
EXTENSION_URL=https://questionmaker.eduai.ok.ubc.ca
CORS_ORIGINS=https://questionmaker.eduai.ok.ubc.ca
ENCRYPTION_KEY=<generate-a-long-random-encryption-key>

# One-time Canvas credential migration (QM -> Core, #1084).
# QM no longer stores Canvas tokens. On startup the container runs
# scripts/migrate-canvas-integrations-to-core.mjs before `prisma migrate deploy`
# renames canvas_integrations away. Required only while this deployment still has
# QM canvas_integrations rows; with rows present but CORE_DATABASE_URL unset the
# copier exits non-zero and the container fails to start. Safe to delete both
# lines once Core rows are verified and the backup table has been dropped.
# See docs/DEPLOYMENT.md -> "Canvas credentials: QM -> Core (one-time)".
CORE_DATABASE_URL=postgresql://<core-user>:<core-database-password>@127.0.0.1:5432/<core-database>
CORE_ENCRYPTION_KEY=<Core-ENCRYPTION_KEY-value-separate-from-the-QM-key-above>

EDUAI_API_URL=https://my.eduai.ok.ubc.ca/api
EDUAI_API_KEY=<same-service-key-authorized-by-Core>

LOG_LEVEL=info
