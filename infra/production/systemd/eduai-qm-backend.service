[Unit]
Description=EduAI Question Maker production API
After=network-online.target eduai-core.service
Wants=network-online.target

[Service]
Type=simple
# #1872: dedicated locked, no-login service account (not a person's account).
User=service_eduai
Group=eduai
UMask=0007
WorkingDirectory=/srv/www/eduai-production/current/apps/extensions/question-maker/app/backend
EnvironmentFile=/etc/eduai/eduai-qm.env
Environment=HOME=/var/lib/service_eduai
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PORT=8000
Environment=HOST=127.0.0.1
# Do not let an incomplete release become a runtime module-not-found loop.
ExecStartPre=/usr/bin/test -f /srv/www/eduai-production/current/apps/extensions/question-maker/app/backend/node_modules/@eduai/question-maker-prisma-client/index.js
ExecStart=/usr/local/bin/node src/index.js
Restart=always
RestartSec=5
TimeoutStartSec=90
KillMode=control-group

[Install]
WantedBy=multi-user.target
