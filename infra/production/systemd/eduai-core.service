[Unit]
Description=EduAI Core production service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# #1872: dedicated locked, no-login service account (not a person's account).
User=service_eduai
Group=eduai
UMask=0007
WorkingDirectory=/srv/www/eduai-production/current/apps/core
EnvironmentFile=/etc/eduai/eduai-core.env
Environment=HOST=127.0.0.1
Environment=HOME=/var/lib/service_eduai
ExecStart=/usr/local/bin/node /srv/www/eduai-production/current/node_modules/@react-router/serve/bin.js ./build/server/index.js
Restart=always
RestartSec=5
TimeoutStartSec=120
KillMode=control-group

[Install]
WantedBy=multi-user.target
