[Unit]
Description=EduAI AI Tutor production API
After=network-online.target eduai-core.service
Wants=network-online.target

[Service]
Type=simple
# #1872: dedicated locked, no-login service account (not a person's account).
User=service_eduai
Group=eduai
UMask=0007
WorkingDirectory=/srv/www/eduai-production/current/apps/extensions/ai-tutor/server
EnvironmentFile=/etc/eduai/eduai-aitutor.env
Environment=HOME=/var/lib/service_eduai
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PORT=4000
Environment=HOST=127.0.0.1
# Releases are required to contain the extension-local generated client. The
# deployment gate checks this before activation; this guard keeps a manually
# switched or damaged release from producing an opaque module-not-found loop.
ExecStartPre=/usr/bin/test -f /srv/www/eduai-production/current/apps/extensions/ai-tutor/server/node_modules/@eduai/ai-tutor-prisma-client/index.js
ExecStart=/usr/local/bin/node src/index.js
Restart=always
RestartSec=5
TimeoutStartSec=120
KillMode=control-group

[Install]
WantedBy=multi-user.target
