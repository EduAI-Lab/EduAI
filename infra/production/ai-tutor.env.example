# Secret-free production AI Tutor API template.
# Install as /etc/eduai/eduai-aitutor.env with mode 0640, root:eduai.

NODE_ENV=production
PORT=4000

# Dedicated AI Tutor database; do not reuse Core's database or legacy .env.
DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:54321/ai_tutor_prod?schema=public

# Shared Core session validation and server-to-server API.
CORE_URL=https://my.eduai.ok.ubc.ca
EDUAI_BASE_URL=https://my.eduai.ok.ubc.ca/api
EDUAI_API_KEY=<same-secret-as-Core-EDUAI_API_KEY>
EDUAI_ENFORCE_URL_CONSISTENCY=1

# Exact browser origin; production CORS is fail-closed when this is absent.
CORS_ORIGINS=https://aitutor.ok.ubc.ca
