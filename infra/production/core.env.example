# Secret-free production Core template.
# Install the completed file as /etc/eduai/eduai-core.env; do not commit real values.

NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/<database>?schema=public
BETTER_AUTH_SECRET=<generate-a-long-random-secret>
BETTER_AUTH_URL=https://my.eduai.ok.ubc.ca
# Shared auth is enabled because the AI Tutor production alias is now part of
# the approved EduAI surface.
# The production aliases are sibling hosts under ok.ubc.ca, so shared auth
# must use the common parent domain. Confirm no unrelated ok.ubc.ca service is
# served from this browser scope before enabling this setting.
COOKIE_DOMAIN=.ok.ubc.ca

# Server-to-server extension key. Generate once outside Git and install the
# exact same value in /etc/eduai/eduai-aitutor.env.
EDUAI_API_KEY=<generate-a-long-random-service-key>
AI_TUTOR_SERVER_URL=http://127.0.0.1:4000

# Core RAG / embeddings. CMPS01 exposes an OpenAI-compatible local endpoint.
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=1024
VLLM_EMBEDDING_BASE_URL=http://cmps01.ok.ubc.ca:8001/v1
VLLM_EMBEDDING_MODEL=mxbai-embed-large
CMPS01_INTERNAL_BASE_URL=http://cmps01.ok.ubc.ca:8001

# Canvas credential encryption.
ENCRYPTION_KEY=<64-hex-characters>

# Campus inference. CMPS01 and CMPS03 serve the standard Qwen3.5 small/large
# pair. CMPS02 serves the small model plus Qwen3.8 27B for Assist Auto. The
# protected port-8001 edges must use the same bearer secret as VLLM_API_KEY.
VLLM_BASE_URL=http://cmps01.ok.ubc.ca:8001
VLLM_API_KEY=<shared-inference-edge-key>
CMPS01_INTERNAL_KEY=<shared-inference-edge-key>
VLLM_FLEET_CHAT_URLS=http://cmps01.ok.ubc.ca:8001,http://cmps02.ok.ubc.ca:8001,http://cmps03.ok.ubc.ca:8001
VLLM_FLEET_DEFAULT_MODELS=qwen3.5-2b-instruct,qwen3.5-9b-instruct
ADHD_ASSIST_AUTO_MODEL=vllm:qwen3.8-27b-instruct
# VLLM_FLEET_HEAVY_URL is intentionally unset; background AI jobs are disabled.

# Redis/BullMQ. Keep enqueue disabled until a worker is deployed and healthy.
REDIS_URL=redis://127.0.0.1:6379
QUEUE_ENQUEUE_ENABLED=false

# Production request limits and logging.
LOG_LEVEL=info
SESSION_VALIDATE_RATE_LIMIT=300
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_MS=60000

# Optional invitation email transport.
# SMTP_HOST=<institutional-relay>
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<username>
# SMTP_PASS=<secret>
# EMAIL_FROM=EduAI <no-reply@eduai.ok.ubc.ca>

# Public extension links are compiled into the browser bundle at build time.
VITE_EDUAI_URL=https://my.eduai.ok.ubc.ca
VITE_AI_TUTOR_URL=https://aitutor.eduai.ok.ubc.ca
VITE_QUESTION_MAKER_URL=https://questionmaker.eduai.ok.ubc.ca
