map $http_x_eduai_internal_key $eduai_internal_key_ok {
    default 0;
    "${EDUAI_INTERNAL_KEY}" 1;
}

server {
    listen 8001;
    listen [::]:8001;
    server_name _;

    client_max_body_size 64m;
    proxy_read_timeout 600s;
    proxy_connect_timeout 60s;
    proxy_send_timeout 600s;

    location = /_large_model_health {
        internal;
        proxy_pass http://127.0.0.1:18002/health;
    }

    location = /v1/models {
        include /etc/nginx/conf.d/internal-allow.conf;
        auth_request /_large_model_health;
        proxy_pass http://127.0.0.1:18091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    location = /health {
        include /etc/nginx/conf.d/internal-allow.conf;
        proxy_pass http://127.0.0.1:18002/health;
        proxy_http_version 1.1;
    }

    location /energy/ {
        include /etc/nginx/conf.d/internal-allow.conf;
        if ($eduai_internal_key_ok = 0) {
            return 403;
        }
        proxy_pass http://127.0.0.1:9100/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location / {
        include /etc/nginx/conf.d/internal-allow.conf;
        proxy_pass http://127.0.0.1:18091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Content-Type $content_type;
    }
}
