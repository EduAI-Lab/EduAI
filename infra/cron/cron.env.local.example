# infra/cron/cron.env.local.example
# Copy to cron.env.local (same directory) for local dry-runs. Never commit cron.env.local.
#
#   cp infra/cron/cron.env.local.example infra/cron/cron.env.local
#
# Loaded by infra/cron/dry-run-local.sh — not by production scripts.

# ── Database connections (docker-compose.dev.yml defaults) ───────
DB_HOST=localhost
DB_PORT_CORE=54320
DB_PORT_TUTOR=54321
DB_PORT_QM=55432
DB_USER=postgres

# Core + AI Tutor use postgres; Question Maker dev image uses password (see docker-compose.dev.yml)
DB_PASS=postgres
DB_PASS_QM=password

# ── Local backup paths (under repo; gitignored) ──────────────────
BACKUP_DIR=.local-backup-test/dumps
BACKUP_RETAIN_DAYS=1
LOCAL_OFFSITE_DIR=.local-backup-test/offsite

# Production off-site target — unused when dry-run uses LOCAL_OFFSITE_DIR
OFFSITE_BUCKET=s3://your-ubc-backup-bucket/eduai

# ── Logs ─────────────────────────────────────────────────────────
AUDIT_LOG=.local-backup-test/data-lifecycle.log

# Alerts are logged only locally (mail is not required for dry-runs)
ALERT_EMAIL=test@local
