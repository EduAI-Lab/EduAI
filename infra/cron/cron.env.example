# infra/cron/cron.env.example
# Copy to /etc/eduai/cron.env on the production server.
# Set chmod 640 and chown root:eduai-cron — NEVER commit real values.
# Loaded by all EduAI cron scripts via:  source /etc/eduai/cron.env

# ── Database connections ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT_CORE=54320
DB_PORT_TUTOR=54321
DB_PORT_QM=55432
DB_USER=postgres
DB_PASS=changeme          # override with vault secret in production

# Per-database overrides (#1873). Production's three databases each have their
# own name, user and password; set these there. Unset values fall back to
# DB_USER / DB_PASS above and the local development names. DB_CONTAINER_* is
# only used when the cron user can run docker (dev); production uses the host
# pg_dump, which must be at least the server's major version.
# DB_NAME_CORE=eduai
# DB_USER_CORE=
# DB_PASS_CORE=
# DB_CONTAINER_CORE=eduai-db
# DB_NAME_TUTOR=ai-tutor
# DB_USER_TUTOR=
# DB_PASS_TUTOR=
# DB_CONTAINER_TUTOR=eduai-ai-tutor-db
# DB_NAME_QM=question-maker
# DB_USER_QM=
# DB_PASS_QM=
# DB_CONTAINER_QM=eduai-question-maker-db

# ── Standalone cron lease ───────────────────────────────────────
# Used only when a script is invoked without CORE_CRON_RUN_ID. Keep this
# longer than the slowest direct run; the value is milliseconds.
CRON_STANDALONE_LEASE_MS=600000

# ── Backup destination ───────────────────────────────────────────
BACKUP_DIR=/var/backups/eduai
BACKUP_RETAIN_DAYS=30     # rolling window kept locally

# S3 example — replace with your UBC-approved storage target
# For SFTP use:  sftp://user@host/path
OFFSITE_BUCKET=s3://your-ubc-backup-bucket/eduai

# ── Audit log ─────────────────────────────────────────────────────
AUDIT_LOG=/var/log/eduai/data-lifecycle.log

# ── Notification ─────────────────────────────────────────────────
ALERT_EMAIL=admin@eduai.local
