# infra/cron/cron.env.example
# Copy to /etc/eduai/cron.env on the production server.
# Set chmod 640 and chown root:eduai-cron — NEVER commit real values.
# Loaded by all EduAI cron scripts via:  source /etc/eduai/cron.env

# ── Database connections ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT_CORE=54320
DB_PORT_TUTOR=54321
DB_PORT_QM=55432
DB_USER=postgres
DB_PASS=changeme          # override with vault secret in production

# ── Backup destination ───────────────────────────────────────────
BACKUP_DIR=/var/backups/eduai
BACKUP_RETAIN_DAYS=30     # rolling window kept locally

# S3 example — replace with your UBC-approved storage target
# For SFTP use:  sftp://user@host/path
OFFSITE_BUCKET=s3://your-ubc-backup-bucket/eduai

# ── Audit log ─────────────────────────────────────────────────────
AUDIT_LOG=/var/log/eduai/data-lifecycle.log

# ── Notification ─────────────────────────────────────────────────
ALERT_EMAIL=admin@eduai.local
