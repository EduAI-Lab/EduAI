# Dependencies & build artifacts
node_modules/
dist/
build/
.next/
.react-router/
.turbo/
coverage/

# Secrets — keep .env.example visible for agents
.env
.env.*
!.env.example
apps/**/.env
apps/**/.env.*
!apps/**/.env.example

# Large / generated research & eval outputs
eval-runs/
apps/core/output/


# Local databases
*.db
*.sqlite

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / personal notes (see .gitignore)
.vscode/
.cursor/
misc/

# Per-app lockfiles (workspace uses root lock only)
apps/**/package-lock.json
