generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                 @id @default(cuid())
  email             String                 @unique
  name              String
  image             String?
  role              UserRole
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  emailVerified     Boolean                @default(false)
  accounts          Account[]
  aiInteractions    AIInteraction[]
  enrolledCourses   CourseEnrollment[]
  assistedCourses   CourseTA[]
  taughtCourses     Course[]               @relation("ProfessorCourses")
  uploadedDocuments Document[]
  sessions          Session[]
  providerSettings  UserProviderSettings[]
  apiKeys           apikey[]
  chats             Chat[]
  externalUsers     ExternalUser[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model Course {
  id             String             @id @default(cuid())
  code           String             @unique
  name           String
  description    String?
  term           String
  year           Int
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  professorId    String
  aiInstructions String             @default("")
  aiInteractions AIInteraction[]
  enrollments    CourseEnrollment[]
  materials      CourseMaterial[]
  tas            CourseTA[]
  professor      User               @relation("ProfessorCourses", fields: [professorId], references: [id])
  documents      Document[]
  categories     CourseCategory[]   @relation("CourseToCategory") // one course has many categories

  @@map("courses")
}

model CourseCategory {
  id          String  @id @default(cuid())
  name        String
  description String? // ? means optional
  courseId    String // foreign key that links each category to a specific course and its also indexed for faster lookups , basically a shortcut.

  course Course  @relation("CourseToCategory", fields: [courseId], references: [id], onDelete: Cascade) // a category belongs to one course 
  topics Topic[] @relation("CategoryToTopic") // one category has many topics, the square brackets represent the many relationships

  @@index([courseId]) //ensures that topics are fetched via their categoryId and not the courseId 
  @@map("course_categories")
}

model Topic {
  id          String   @id @default(cuid()) // @id tells prisma that this field is the primary key of the table. default cuid() stands for “Collision-Resistant Unique ID” . It automatically generates a unique string ID.
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  categoryId  String // foreign key to CourseCategory

  category CourseCategory @relation("CategoryToTopic", fields: [categoryId], references: [id], onDelete: Cascade) // topics belong to a single category which hangs off a course

  @@index([categoryId])
