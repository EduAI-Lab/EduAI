>>>>>>> Fix category/topic API routes + server refactor
  @@map("topics")
}

model CourseTA {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@map("course_tas")
}

model CourseEnrollment {
  id         String   @id @default(cuid())
  courseId   String
  studentId  String
  enrolledAt DateTime @default(now())
  isActive   Boolean  @default(true)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@map("course_enrollments")
}

model Document {
  id           String         @id @default(cuid())
  filename     String
  originalName String
  fileSize     Int
  mimeType     String
  type         DocumentType
  status       DocumentStatus @default(UPLOADING)
  storageKey   String         @unique
  description  String?
  tags         String[]
  uploaderId   String
  courseId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  processedAt  DateTime?
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploader     User           @relation(fields: [uploaderId], references: [id])

  @@map("documents")
}

model AIInteraction {
  id        String   @id @default(cuid())
  userId    String
  courseId  String?
  query     String
  response  String
  context   Json?
  modelUsed String
  tokenUsed Int?
  createdAt DateTime @default(now())
  modelId   String?
  course    Course?  @relation(fields: [courseId], references: [id])
  model     AIModel? @relation(fields: [modelId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("ai_interactions")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String

  @@map("system_config")
}

model AIProvider {
  id             String                 @id @default(cuid())
  name           String                 @unique
  displayName    String
  description    String
  requiresApiKey Boolean                @default(true)
  defaultBaseUrl String?
  envVarName     String?
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  models         AIModel[]
  userSettings   UserProviderSettings[]

  @@map("ai_providers")
}

model AIModel {
  id                String          @id @default(cuid())
  modelId           String
  name              String
  description       String
  type              AIModelType
  maxTokens         Int?
  supportsImages    Boolean         @default(false)
  supportsTools     Boolean         @default(false)
  supportsStreaming Boolean         @default(true)
  inputPricing      Float?
  outputPricing     Float?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  providerId        String
  interactions      AIInteraction[]
  provider          AIProvider      @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelId])
  @@map("ai_models")
}

model UserProviderSettings {
  id         String     @id @default(cuid())
  userId     String
  providerId String
  apiKey     String?
  baseUrl    String?
  isEnabled  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  provider   AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@map("user_provider_settings")
}

model CourseMaterial {
  id          String          @id @default(cuid())
  courseId    String
  title       String
  mimeType    String
  fileSize    Int
  checksum    String          @unique
  rawText     String?
  status      MaterialStatus  @default(PROCESSING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  processedAt DateTime?
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chunks      MaterialChunk[]

  @@map("course_materials")
}

model MaterialChunk {
  id         String             @id @default(cuid())
  materialId String
  index      Int
  content    String
  createdAt  DateTime           @default(now())
  material   CourseMaterial     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  embedding  MaterialEmbedding?

  @@unique([materialId, index])
  @@map("material_chunks")
}

model MaterialEmbedding {
  id        String                      @id @default(cuid())
  chunkId   String                      @unique
  embedding Unsupported("vector(3072)")
  createdAt DateTime                    @default(now())
  chunk     MaterialChunk               @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@map("material_embeddings")
}

model apikey {
  id                  String    @id @default(cuid())
  name                String?
  start               String?
  prefix              String?
  key                 String
  userId              String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(false)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int       @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         Json?
  metadata            Json?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("apiKey")
}

model Chat {
  id           String   @id @default(cuid())
  userId       String
  systemPrompt String?
  title        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@index([userId])
  @@map("chats")
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  messageId String
  role      String
  content   Json
  /// Auto-increment keeps message ordering monotonic even with concurrent writers.
  position  Int      @default(autoincrement())
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, messageId])
  @@index([chatId, position])
  @@map("chat_messages")
}

model ExternalUser {
  id             String   @id @default(cuid())
  provider       String
  externalUserId String
  userId         String
  /// Stores the upstream email for reference; User.email remains canonical.
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalUserId])
  @@index([userId])
  @@map("external_users")
}

enum UserRole {
  ADMIN
  PROFESSOR
  TA
  STUDENT
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum DocumentType {
  PDF
  TEXT
  DOCX
  MARKDOWN
  OTHER
}

enum AIModelType {
  CHAT
  COMPLETION
  EMBEDDING
  IMAGE
  AUDIO
  VIDEO
}

enum MaterialStatus {
  PROCESSING
  READY
  FAILED
}



