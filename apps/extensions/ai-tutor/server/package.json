{
  "name": "ai-tutor-server",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "vitest run && vitest run --config vitest.integration.config.js",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.js",
    "start": "npx prisma generate && node src/index.js",
    "dev": "npx prisma migrate deploy && npx prisma generate && npm run seed:if-empty && nodemon src/index.js",
    "seed": "tsx prisma/seed.ts",
    "seed:if-empty": "tsx prisma/seed-if-empty.ts",
    "seed:perf": "tsx prisma/seed-perf.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eduai/types": "*",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "oxlint": "^1.78.0",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9"
  }
}
