# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54321/ai-tutor?schema=public"

# Server Configuration
PORT=4000

# Core integration (session validation and login redirect)
CORE_URL="http://localhost:3000"

# UBC eduAI API Configuration
EDUAI_API_KEY="your-eduai-api-key-here"
EDUAI_BASE_URL="http://localhost:3000/api"
EDUAI_MODEL="google:gemini-2.5-flash"

# AI Supervisor (two-agent review)
# Set to "false" to disable supervisor review loop
AI_SUPERVISOR_ENABLED=true
