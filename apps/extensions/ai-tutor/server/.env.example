# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:54321/ai-tutor?schema=public"

# CORS — comma-separated exact browser origins (no wildcards, no spaces around commas)
# When unset or blank, local/development/test uses http://localhost:3001.
# Production and other named environments default to an empty, fail-closed allowlist.
# CORS_ORIGINS="http://localhost:3001"

# Server Configuration
PORT=4000

# Core integration (session validation and login redirect)
CORE_URL="http://localhost:3000"

# UBC eduAI API Configuration
# EDUAI_API_KEY must match apps/core/.env (Core only reads its own env, not admin UI overrides).
# EDUAI_BASE_URL: Core API base for course import/sync. Local dev with Core on :3000:
#   EDUAI_BASE_URL="http://localhost:3000/api"
EDUAI_API_KEY="your-eduai-api-key-here"
EDUAI_BASE_URL="http://localhost:3000/api"
EDUAI_MODEL="google:gemini-2.5-flash"
# Optional — TTL (ms) for cached Core RBAC policy flags fetched from GET /api/policies
# POLICY_CACHE_TTL_MS="30000"
# Optional — timeout (ms) for a single EduAI chat completion round-trip (default: 45000)
# EDUAI_CALL_TIMEOUT_MS="45000"
