# Copy to apps/extensions/example-extension/.env before running.
# See docs/EXTENSION_ONBOARDING.md for the full setup guide.

# --- Core integration (required) ---

# URL of Core — used by session validation middleware and login redirects
CORE_URL=http://localhost:3000

# Public URL of this extension — used to build the ?redirect= param after Core login
EXTENSION_URL=http://localhost:9000

# --- Server ---
PORT=9000

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:9000,http://localhost:3000

# --- Core API (for service-level calls) ---
# Must match EDUAI_API_KEY in Core's .env
EDUAI_API_KEY=

# Core API base URL (for forwarding user-scoped API requests)
EDUAI_BASE_URL=http://localhost:3000/api
