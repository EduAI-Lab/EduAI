{
  "name": "question-maker-backend",
  "version": "1.0.0",
  "description": "EduQuery.ai Backend API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run db:generate && npm run db:migrate:deploy && npm run seed:if-empty && nodemon --watch src --ext js,mjs,cjs,json src/index.js",
    "start": "npm run db:generate && npm run db:migrate:deploy && node src/index.js",
    "build": "echo 'No build step required'",
    "test": "vitest run && vitest run --config vitest.integration.config.js",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/withPrismaEnv.js generate",
    "db:migrate": "node scripts/withPrismaEnv.js migrate dev",
    "db:baseline": "node scripts/baselineExistingDatabase.js",
    "db:migrate:canvas-to-core": "node scripts/migrate-canvas-integrations-to-core.mjs",
    "db:migrate:deploy": "npm run db:baseline && npm run db:migrate:canvas-to-core && node scripts/withPrismaEnv.js migrate deploy",
    "seed": "node scripts/seedUnified.js",
    "seed:if-empty": "node scripts/seedIfEmpty.js",
    "seed:perf": "node scripts/seed-perf.js",
    "seed:production": "node scripts/seedProductionQuestions.js",
    "test:ocr": "node scripts/testOcrExtraction.js"
  },
  "dependencies": {
    "@eduai/types": "*",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "axios": "^1.13.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "node-cron": "^4.2.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.13.0",
    "nodemon": "^3.1.10",
    "pdf-parse": "^2.4.5",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
