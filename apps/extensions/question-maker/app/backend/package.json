{
  "name": "question-maker-backend",
  "version": "1.0.0",
  "description": "EduQuery.ai Backend API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "build": "echo 'No build step required'",
    "test": "vitest run && vitest run --config vitest.integration.config.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:all": "npm run test",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.js",
    "lint": "eslint . --max-warnings=0",
    "seed": "node scripts/seedUnified.js",
    "seed:production": "node scripts/seedProductionQuestions.js",
    "test:ocr": "node scripts/testOcrExtraction.js"
  },
  "dependencies": {
    "@eduai/types": "*",
    "@paralleldrive/cuid2": "^2.2.2",
    "axios": "^1.13.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pg": "^8.11.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "sequelize": "^6.35.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.13.0",
    "pdf-parse": "^2.4.5",
    "pino-pretty": "^13.1.3",
    "supertest": "^6.3.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
