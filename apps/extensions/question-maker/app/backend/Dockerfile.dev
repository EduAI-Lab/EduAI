# Build context: monorepo root
FROM node:24-alpine

WORKDIR /workspace

RUN addgroup -g 1001 -S nodejs \
    && adduser -S nodejs -u 1001 -G nodejs \
    && chown nodejs:nodejs /workspace

COPY --chown=nodejs:nodejs package.json package-lock.json .npmrc ./
COPY --chown=nodejs:nodejs packages/types/package.json packages/types/package.json
COPY --chown=nodejs:nodejs apps/extensions/question-maker/app/backend/package.json \
    apps/extensions/question-maker/app/backend/package.json

USER nodejs

RUN npm ci --ignore-scripts \
      --workspace=question-maker-backend \
      --workspace=@eduai/types \
      --include-workspace-root=false

COPY --chown=nodejs:nodejs packages/types packages/types
COPY --chown=nodejs:nodejs apps/extensions/question-maker/app/backend \
    apps/extensions/question-maker/app/backend

RUN npm run build -w @eduai/types \
    && mkdir -p apps/extensions/question-maker/app/backend/node_modules

WORKDIR /workspace/apps/extensions/question-maker/app/backend

EXPOSE 8000
CMD ["npm", "run", "dev"]
