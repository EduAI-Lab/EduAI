# Copy to apps/extensions/question-maker/.env (postinstall does this on a clean clone).
# Read by app/backend/src/config/settings.js, for both `npm run dev` and docker-compose.

# --- Core (required) ---
NODE_ENV=development
PORT=8000
# Host-run monorepo/dev only. Production Compose injects the internal service
# address below and does not publish PostgreSQL on a host port.
DATABASE_URL=postgresql://postgres:password@localhost:55432/question-maker
# When running inside Docker Compose (service-to-service), use:
# DATABASE_URL=postgresql://postgres:password@postgres:5432/question-maker

# URL of the Core auth server (used by session validation middleware)
CORE_URL=http://localhost:3000
# Deadline for Core session validation and logout calls (milliseconds; default 5000)
# CORE_AUTH_TIMEOUT_MS=5000
# Public URL of this extension (used to build the ?redirect= param after Core login)
EXTENSION_URL=http://localhost:8000

# Comma-separated browser origins allowed by CORS (no spaces after commas)
CORS_ORIGINS=http://localhost:5173

# 64-char hex (32 bytes). Required in production — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- One-time Canvas credential migration: QM -> Core (#1084) ---
# QM no longer stores Canvas tokens. `db:migrate:deploy` (and the production
# container command) runs scripts/migrate-canvas-integrations-to-core.mjs before
# `prisma migrate deploy` renames canvas_integrations away. Set these only while
# this database still has QM canvas_integrations rows — with rows present and
# CORE_DATABASE_URL unset the copier exits non-zero rather than skipping.
# Core and QM hold separate keys; see docs/DEPLOYMENT.md and docs/ENVIRONMENT.md.
# CORE_DATABASE_URL=postgresql://postgres:postgres@localhost:54320/eduai
# CORE_ENCRYPTION_KEY=

# --- Logging & rate limiting (optional) ---
LOG_LEVEL=info
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=1000

# --- EduAI / Core (EDUAI_API_KEY is required and must match Core for session validation) ---
EDUAI_API_URL=https://eduai.ok.ubc.ca
EDUAI_API_KEY=
# Optional comma-separated course codes to hide from the course picker
# EDUAI_IGNORED_COURSE_CODES=courseA,courseB

# --- Direct LLM keys (optional; used when generating questions with Groq / OpenAI / DeepSeek) ---
# GROQ_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Optional tuning (defaults exist in code)
# DEFAULT_NUM_QUESTIONS=15
# MAX_QUESTIONS=50

# Question Maker AI resource budgets (finite defaults; adjust only with care).
# OCR text: 120000 chars; at most 24 chunks and 36 EduAI calls per extraction;
# 120000ms total extraction deadline; 30000ms per provider call.
# Legacy /generate prompt: 12000 chars; caller-keyed AI quota: 60 requests / 15m.
# QM_MAX_EXTRACT_TEXT_CHARS=120000
# QM_MAX_EXTRACT_CHUNKS=24
# QM_MAX_EXTRACT_PROVIDER_CALLS=36
# QM_EXTRACT_DEADLINE_MS=120000
# QM_AI_PROVIDER_TIMEOUT_MS=30000
# QM_GENERATE_PROMPT_MAX_CHARS=12000
# QM_AI_RATE_LIMIT_WINDOW_MS=900000
# QM_AI_RATE_LIMIT_MAX=60

# Milliseconds to cache the caller's synced Core enrollment access (and the
# ADMIN full-course catalog) before `GET /api/course` refreshes it from Core
# again — trades a short window of staleness for fewer Core round-trips per
# page request (#1206/#1410, courseListService.js). Defaults to 60000 (60s).
# COURSE_ACCESS_SYNC_TTL_MS=60000

# `requireAuth` upserts the caller's local `users` row on every request purely
# for FK integrity, and that upsert never updates an existing row — so once the
# row exists it is a write that changes nothing. Known user ids are memoized per
# process for this long before the upsert runs again on side-effect-free reads.
# Mutating requests and course/question mirror reads always re-run the upsert
# before dependent writes, so a row removed out of band cannot lose the first
# write (#1388, authService.js).
# Defaults to 900000 (15 min). USER_ROW_CACHE_MAX bounds how
# many ids one process holds before expired entries are pruned and, failing
# that, the map is cleared (defaults to 5000). Setting either to 0 disables the
# cache for side-effect-free reads entirely — mutating requests still upsert.
# USER_ROW_CACHE_TTL_MS=900000
# USER_ROW_CACHE_MAX=5000

# --- Bug report admin (optional) ---
# Comma-separated emails that may access the bug-report triage UI in addition to the default admin user.
# BUG_REPORT_ADMIN_EMAILS=

# --- Frontend (Vite loads from repo root) ---
VITE_API_URL=http://localhost:8000
VITE_CORE_URL=http://localhost:3000
VITE_AI_TUTOR_URL=http://localhost:3001
# Optional: a reachable HTTPS Canvas host for development/test-mode prefill.
# Leave empty when each tester uses a different Canvas account/instance.
VITE_CANVAS_DEFAULT_URL=

# --- Integration tests (optional; used by the Vitest integration suite) ---
# Unset by default so integration tests self-skip locally.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:55432/question_maker_test

# --- Production Docker Compose only (see docker-compose.yml) ---
# POSTGRES_PASSWORD_PRODUCTION=strong-random-password

# Git authentication is configured outside this application environment with
# a read-only SSH deploy key or OS credential helper. Never put a PAT here.
