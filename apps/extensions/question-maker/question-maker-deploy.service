[Unit]
Description=Question Maker Auto-Deploy Service
After=network.target

[Service]
Type=oneshot
User=ssaada08
Group=questionmaker
WorkingDirectory=/srv/www/EduAI
Environment=PROJECT_DIR=/srv/www/EduAI
Environment=BRANCH=development
ExecStart=/srv/www/EduAI/apps/extensions/question-maker/scripts/daily-deploy.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
