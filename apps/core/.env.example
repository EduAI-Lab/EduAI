NODE_ENV="development"

DATABASE_URL="postgresql://postgres:postgres@localhost:54320/eduai?schema=public"

# Better Auth Config
BETTER_AUTH_SECRET="" # REQUIRED: Generate a strong random secret (e.g., `openssl rand -base64 32`)
BETTER_AUTH_URL="http://localhost:3000" # Base URL of your app

# Optional: Vite HMR when using HTTPS reverse proxy (browser → public host, proxy → localhost:3000).
# Set the public hostname and the port the browser uses (usually 443). The proxy must allow WebSocket upgrade.
# DEV_SERVER_HMR_HOST="dev.eduai.ok.ubc.ca"
# DEV_SERVER_HMR_CLIENT_PORT="443"

# --- Embeddings (RAG index + query) — see docs/rag-ai/EMBEDDINGS.md and LOCAL-EMBEDDINGS.md ---
# pgvector column is vector(1024) after LOCAL-EMBEDDINGS migration; re-embed materials after provider changes.

# Dev server (cmps01): local Ollama embeds
EMBEDDING_PROVIDER="local"
EMBEDDING_DIMENSION="1024"
OLLAMA_BASE_URL="http://localhost:11434/"
OLLAMA_EMBEDDING_MODEL="mxbai-embed-large"
# OLLAMA_EMBED_MANY_BATCH_SIZE="8" # initial batch size; auto-splits on Ollama 400 Bad Request

# Laptop / cloud fallback (1024-dim models only — do not use legacy Gemini 3072 without EMBEDDING_DIMENSION=3072)
# EMBEDDING_PROVIDER="cloud"
OPENROUTER_API_KEY="" # OpenRouter — default openai/text-embedding-3-small @ 1024 dims when EMBEDDING_DIMENSION=1024
# OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"
# OPENROUTER_HTTP_REFERER="" # Optional; defaults to BETTER_AUTH_URL for OpenRouter rankings
# OPENROUTER_APP_TITLE="EduAI"
# GOOGLE_GENERATIVE_AI_API_KEY="" # Direct Gemini (3072-dim legacy path only when EMBEDDING_DIMENSION=3072)
# OPENAI_API_KEY="" # Direct OpenAI text-embedding-3-small with dimensions=1024

# vLLM — LiteLLM proxy on cmps01 (one URL for all GPU models); see infra/cmps01/README.md
# VLLM_BASE_URL="http://cmps01.ok.ubc.ca:8001"
# Multi-server fleet (round-robin across healthy chat hosts):
# VLLM_FLEET_CHAT_URLS="http://cmps01.ok.ubc.ca:8001,http://cmps02.ok.ubc.ca:8001"
# VLLM_FLEET_HEAVY_URL="http://cmps03.ok.ubc.ca:8001"
# VLLM_FLEET_DEFAULT_MODELS="qwen2.5-7b-instruct,qwen2.5-32b-instruct"
# VLLM_API_KEY="vllm-local"

# Energy meter sidecar (tools/energy-meter on inference host):
# GPU energy sidecar (cmps01 host). Via nginx edge: :8001/energy + CMPS01_INTERNAL_KEY (see infra/cmps01/README.md).
# ENERGY_SIDECAR_URL=http://cmps01.ok.ubc.ca:8001/energy
# CMPS01_INTERNAL_KEY=""
# Direct localhost on inference host only:
# ENERGY_SIDECAR_URL=http://127.0.0.1:9100

# Chat context caps (Form A §3b — #259/#260). Optional; code defaults shown. No secrets.
# CHAT_TOOL_RAG_MAX_CHARS_PER_CHUNK="6000"   # Per tool-result cap (fetchPage/getInformation/reloaded tool msgs); clamps 500–50000
# CHAT_MAX_CONTEXT_MESSAGES="20"             # Messages loaded from DB and tail-trimmed before the model; clamps 4–50
# CHAT_SESSION_MAX_CHARS="28000"             # Total model-input char budget before older turns are digested; clamps 2000–100000
# CHAT_SESSION_RECENT_MESSAGES="6"           # Recent turns kept verbatim when the digest runs; clamps 2–50
# CHAT_SESSION_DIGEST_MAX_CHARS="14000"      # Max size of the synthetic session-digest block; clamps 500–50000

# Chat latency (#203 L03) — hybrid RAG when course selected
# CHAT_HYBRID_RAG_ALWAYS_WITH_COURSE="0"

# ADHD Assist Phase 3 oversight — second-pass structural audit when Assistive Mode is ON (default: enabled)
# ADHD_ASSIST_OVERSIGHT="false"              # Set to false/0/off to disable rewrite pass

# Service key shared with AI Tutor and Question Maker for server-to-server calls.
# Must match apps/extensions/ai-tutor/server/.env (and QM backend) exactly.
# Generate with: openssl rand -hex 32
EDUAI_API_KEY=""

# Extension base URLs for server-to-server calls Core makes out to the
# extensions (currently: cascade-delete propagation on course deletion, #802).
# Leave unset in environments where an extension isn't running — the cascade
# call is skipped silently and the extension's own reconcile cron self-heals.
# QM_BACKEND_URL="http://localhost:8000"
# AI_TUTOR_SERVER_URL="http://localhost:4000"

# --- Job queue (Redis / BullMQ) ---
# Redis connection for the async AI-job queue. Dev Redis runs via docker-compose.dev.yml
# (host port CORE_REDIS_PORT, default 63790).
REDIS_URL="redis://localhost:63790"

# Max requests per minute per IP for POST /api/sessions/validate (default: 300)
SESSION_VALIDATE_RATE_LIMIT=300

# Canvas instructor credentials (AES-256-GCM; same format as Question Maker ENCRYPTION_KEY)
ENCRYPTION_KEY=""

# Extension sidebar links — set the URL to show the extension in Core's sidebar;
# omit (or comment out) to hide it. This is the primary way to control which
# extensions appear per environment: set in dev, omit in prod for any extension
# that isn't deployed there.
VITE_AI_TUTOR_URL="http://localhost:3001"
VITE_QUESTION_MAKER_URL="http://localhost:5173"

# Additional extensions — add any new extension to the sidebar without editing apps.tsx.
# JSON array with required fields: id, name, url. Optional: description, color (CSS color string).
# Use single quotes in .env files to avoid shell escaping issues with the inner double quotes.
# VITE_EXTRA_EXTENSIONS='[{"id":"example","name":"Example Extension","url":"http://localhost:9000","description":"Demo extension"}]'

# Timezone used for UBC academic term code derivation (W1/W2/S1/S2 from course start date).
# Change this if the institution uses a different local time — the Intl.DateTimeFormat IANA name.
UBC_TIMEZONE="America/Vancouver"

# --- Invitation emails (admin onboarding of ADMIN / UNIT_ADMIN / INSTRUCTOR) ---
# SMTP transport: Mailtrap in dev, institutional relay in prod. When SMTP_HOST
# is unset, the invite accept-link is logged to the console instead of emailed
# (no crash in unconfigured environments). The accept link is built from
# BETTER_AUTH_URL.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"            # true for implicit TLS (port 465)
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="EduAI <no-reply@eduai.local>"
# INVITE_EXPIRY_HOURS="72"       # invitation link lifetime in hours (default 72)
