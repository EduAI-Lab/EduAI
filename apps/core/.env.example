NODE_ENV="development"

DATABASE_URL="postgresql://postgres:postgres@localhost:54320/eduai?schema=public"

# Better Auth Config
BETTER_AUTH_SECRET="" # REQUIRED: Generate a strong random secret (e.g., `openssl rand -base64 32`)
BETTER_AUTH_URL="http://localhost:3000" # Base URL of your app

# Optional: Vite HMR when using HTTPS reverse proxy (browser → public host, proxy → localhost:3000).
# Set the public hostname and the port the browser uses (usually 443). The proxy must allow WebSocket upgrade.
# DEV_SERVER_HMR_HOST="dev.eduai.ok.ubc.ca"
# DEV_SERVER_HMR_CLIENT_PORT="443"

# Embeddings (first match wins): OpenRouter → Google → OpenAI direct
OPENROUTER_API_KEY="" # OpenRouter key — uses gemini-embedding-001 via OpenRouter (3072-dim, matches DB)
# OPENROUTER_EMBEDDING_MODEL="google/gemini-embedding-001"
# OPENROUTER_HTTP_REFERER="" # Optional; defaults to BETTER_AUTH_URL for OpenRouter rankings
# OPENROUTER_APP_TITLE="EduAI"
GOOGLE_GENERATIVE_AI_API_KEY="" # Direct Google Gemini embeddings (if OpenRouter not set)
# OPENAI_API_KEY="" # Direct OpenAI — text-embedding-3-small is 1536-dim; mismatches vector(3072) unless you migrate
OLLAMA_BASE_URL="http://localhost:11434/"

# vLLM (OpenAI-compatible) — cmps01 or SSH tunnel; see docs/rag-ai/latency/eduai-summer-2026/VLLM_CMPS01_SETUP.md
# VLLM_BASE_URL="http://cmps01.ok.ubc.ca:8000"
# VLLM_API_KEY="vllm-local"