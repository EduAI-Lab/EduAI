NODE_ENV="development"
LOG_LEVEL="info"

# Database — start with: npm run docker:dev:db (runs core-db on port 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eduai?schema=public"

# Auth
BETTER_AUTH_SECRET="" # Generate with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:5173" # Must match the URL you access Core at

# AI Providers
OLLAMA_BASE_URL="http://localhost:11434/"
GOOGLE_GENERATIVE_AI_API_KEY="" # For Google Gemini embeddings
OPENAI_API_KEY="" # Fallback for embeddings if Google key not set

# Tools
FIRECRAWL_API_KEY="" # Web search tool; leave blank to disable

# Routing
# ROUTER_AUTO_DEFAULT="true"

# API key for sister-app access (AI Tutor, Question Maker)
# EDU_AI_API_KEY=""
