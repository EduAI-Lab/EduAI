generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/@prisma/client"
  // "native" auto-detects the local OS; "rhel-openssl-1.1.x" is needed
  // when running on RHEL 8 hosts (e.g. dev.eduai.ok.ubc.ca / s378).
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                 @id @default(cuid())
  email             String                 @unique
  name              String
  image             String?
  role              UserRole
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  emailVerified     Boolean                @default(false)
  authorizedUnits   String[]
  accounts          Account[]
  aiInteractions    AIInteraction[]
  enrollments       Enrollment[]
  questions         Question[]
  sessions          Session[]
  providerSettings  UserProviderSettings[]
  apiKeys           apikey[]
  chats             Chat[]
  externalUsers     ExternalUser[]
  preference        UserPreference?
  bugReports        BugReport[]
  assistiveEvents   AssistiveEvent[]
  uploadedMaterials CourseMaterial[]       @relation("MaterialUploader")
  createdTopics     CourseTopic[]          @relation("TopicCreator")
  canvasIntegration CanvasIntegration?
  invitationsSent   Invitation[]           @relation("InvitationsSent")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model Course {
  id             String           @id @default(cuid())
  code           String
  name           String
  description    String?
  section        String
  term           String
  year           Int
  isActive       Boolean          @default(true)
  isPublished    Boolean          @default(false)
  startDate      DateTime
  endDate        DateTime?
  externalId     String?
  externalSource String?
  lastSyncedAt   DateTime?
  department     String?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  aiInstructions String           @default("")
  /// Per-course override: `local` | `ollama` | `cloud`; null uses server env.
  embeddingProvider    String?
  /// Per-course model id (Ollama or OpenRouter/OpenAI); null uses server default for provider.
  embeddingModel       String?
  lastEmbeddedAt       DateTime?
  embeddedWithProvider String?
  embeddedWithModel    String?
  aiInteractions AIInteraction[]
  enrollments    Enrollment[]
  materials      CourseMaterial[]
  reEmbedJobs    CourseReEmbedJob[]
  topics         CourseTopic[]
  questions      Question[]

  @@unique([code, startDate, section])
  @@index([externalSource, externalId])
  @@map("courses")
}

model CourseReEmbedJob {
  id                   String           @id @default(cuid())
  courseId             String
  status               ReEmbedJobStatus @default(PENDING)
  totalMaterials       Int              @default(0)
  processedCount       Int              @default(0)
  failedMaterialIds    String[]         @default([])
  currentMaterialTitle String?
  errorMessage         String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  course               Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, status])
  @@map("course_re_embed_jobs")
}

model Enrollment {
  id             String         @id @default(cuid())
  courseId       String
  userId         String
  role           EnrollmentRole
  enrolledAt     DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  isActive       Boolean        @default(true)
  externalId     String?
  externalSource String?
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
  @@index([externalSource, externalId])
  @@map("enrollments")
}

model AIInteraction {
  id               String                   @id @default(cuid())
  userId           String
  courseId         String?
  query            String
  response         String
  context          Json?
  modelUsed        String
  createdAt        DateTime                 @default(now())
  modelId          String?
  routedByAuto     Boolean                  @default(false)
  routerVersion    String?
  routerFeatures   Json?
  routerConfidence Float?
  routerChosenTier RouterTier?
  ttftMs           Int?
  durationMs       Int?
  promptTokens     Int?
  completionTokens Int?
  estInputCostUsd  Float?
  estOutputCostUsd Float?
  energyJoules     Float?
  energySource     EnergyMeasurementSource?
  carbonGramsCO2   Float?
  finishReason     String?
  course           Course?                  @relation(fields: [courseId], references: [id])
  model            AIModel?                 @relation(fields: [modelId], references: [id])
  user             User                     @relation(fields: [userId], references: [id])

  @@map("ai_interactions")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String

  @@map("system_config")
}

model AIProvider {
  id             String                 @id @default(cuid())
  name           String                 @unique
  displayName    String
  description    String
  requiresApiKey Boolean                @default(true)
  defaultBaseUrl String?
  envVarName     String?
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  models         AIModel[]
  userSettings   UserProviderSettings[]

  @@map("ai_providers")
}

model AIModel {
  id                         String          @id @default(cuid())
  modelId                    String
  name                       String
  description                String
  type                       AIModelType
  maxTokens                  Int?
  supportsImages             Boolean         @default(false)
  supportsTools              Boolean         @default(false)
  supportsStreaming          Boolean         @default(true)
  inputPricing               Float?
  outputPricing              Float?
  routerTier                 RouterTier?
  estEnergyJoulesPerToken    Float?
  averageCarbonGramsPerToken Float?
  isActive                   Boolean         @default(true)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  providerId                 String
  interactions               AIInteraction[]
  provider                   AIProvider      @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelId])
  @@map("ai_models")
}

model UserProviderSettings {
  id         String     @id @default(cuid())
  userId     String
  providerId String
  apiKey     String?
  baseUrl    String?
  isEnabled  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  provider   AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@map("user_provider_settings")
}

model UserPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  assistDefault  Boolean  @default(false)
  lastCourseCode String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model CourseMaterial {
  id             String          @id @default(cuid())
  courseId       String
  title          String
  mimeType       String
  fileSize       Int
  checksum       String
  rawText        String?
  status         MaterialStatus  @default(PROCESSING)
  externalId     String?
  externalSource String?
  uploadedBy     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  processedAt    DateTime?
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploader       User?           @relation("MaterialUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  chunks         MaterialChunk[]

  @@unique([courseId, checksum])
  @@index([externalSource, externalId])
  @@index([uploadedBy])
  @@map("course_materials")
}

model CourseTopic {
  id              String                   @id @default(cuid())
  courseId        String
  name            String
  createdBy       String?
  deletedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  course          Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator         User?                    @relation("TopicCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  questions       Question[]
  secondaryTopics QuestionSecondaryTopic[]

  @@unique([courseId, name])
  @@index([createdBy])
  @@map("course_topics")
}

model Question {
  id              String                   @id @default(cuid())
  courseId        String
  topicId         String
  createdBy       String
  content         String
  type            QuestionType
  difficulty      QuestionDifficulty       @default(MEDIUM)
  reasoningLevel  ReasoningLevel           @default(FACTUAL)
  choices         Json?
  answer          String?
  testable        Boolean                  @default(false)
  idempotencyKey  String?                  @unique
  deletedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  course          Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic           CourseTopic              @relation(fields: [topicId], references: [id])
  creator         User                     @relation(fields: [createdBy], references: [id])
  secondaryTopics QuestionSecondaryTopic[]

  @@index([courseId, topicId, testable])
  @@index([createdBy])
  @@map("questions")
}

model QuestionSecondaryTopic {
  questionId String
  topicId    String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic      CourseTopic @relation(fields: [topicId], references: [id])

  @@id([questionId, topicId])
  @@index([topicId])
  @@map("question_secondary_topics")
}

model BugReport {
  id          String          @id @default(cuid())
  source      BugReportSource
  userId      String?
  isAnonymous Boolean         @default(false)
  description String          @db.VarChar(2000)
  status      BugReportStatus @default(UNHANDLED)
  consoleLogs String?
  networkLogs String?
  screenshot  String?
  pageUrl     String?
  userAgent   String?
  context     Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@index([source])
  @@map("bug_reports")
}

model MaterialChunk {
  id         String             @id @default(cuid())
  materialId String
  index      Int
  content    String
  createdAt  DateTime           @default(now())
  material   CourseMaterial     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  embedding  MaterialEmbedding?

  @@unique([materialId, index])
  @@map("material_chunks")
}

model MaterialEmbedding {
  id        String                      @id @default(cuid())
  chunkId   String                      @unique
  embedding Unsupported("vector(1024)")
  createdAt DateTime                    @default(now())
  chunk     MaterialChunk               @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@map("material_embeddings")
}

model apikey {
  id                  String    @id @default(cuid())
  name                String?
  start               String?
  prefix              String?
  key                 String
  userId              String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(false)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int       @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         Json?
  metadata            Json?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("apiKey")
}

model Chat {
  id           String        @id @default(cuid())
  userId       String
  systemPrompt String?
  title        String?
  adhdAssist   Boolean  @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        ChatMessage[]
  assistiveEvents AssistiveEvent[]

  @@index([userId])
  @@map("chats")
}

model AssistiveEvent {
  id          String   @id @default(cuid())
  userId      String
  chatId      String?
  adhdAssist  Boolean  @default(false)
  eventType   String
  metricsJson Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat        Chat?    @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([adhdAssist, createdAt])
  @@index([chatId])
  @@map("assistive_events")
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  messageId String
  role      String
  content   Json
  /// Auto-increment keeps message ordering monotonic even with concurrent writers.
  position  Int      @default(autoincrement())
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, messageId])
  @@index([chatId, position])
  @@map("chat_messages")
}

model CanvasIntegration {
  id         String   @id @default(cuid())
  userId     String   @unique
  canvasUrl  String
  /// AES-256-GCM encrypted Canvas personal access token (see lib/canvas/encryption.ts).
  apiKey     String
  isTestMode Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("canvas_integrations")
}

model ExternalUser {
  id             String   @id @default(cuid())
  provider       String
  externalUserId String
  userId         String
  /// Stores the upstream email for reference; User.email remains canonical.
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalUserId])
  @@index([userId])
  @@map("external_users")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  TA
  STUDENT
  UNIT_ADMIN
}

enum EnrollmentRole {
  STUDENT
  TA
  INSTRUCTOR
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// Admin-issued invitation to onboard a privileged, non-self-serve platform
/// user (ADMIN / UNIT_ADMIN / INSTRUCTOR). The invitee follows a tokenized
/// link, sets a password, and gets a real account with the invited role.
model Invitation {
  id              String           @id @default(cuid())
  email           String
  name            String?
  role            UserRole
  authorizedUnits String[]         @default([])
  /// sha256 of the raw token; the raw token only ever lives in the email link.
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  /// Null when the inviting admin's account has since been deleted.
  invitedById     String?
  invitedBy       User?            @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedUserId  String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([email])
  @@index([status])
  @@map("invitations")
}

enum QuestionType {
  MCQ
  SA
  LA
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ReasoningLevel {
  FACTUAL
  ANALYTICAL
  APPLICATION
}

enum BugReportSource {
  CORE
  AI_TUTOR
  QUESTION_MAKER
}

enum BugReportStatus {
  UNHANDLED
  IN_PROGRESS
  RESOLVED
}

enum AIModelType {
  CHAT
  COMPLETION
  EMBEDDING
  IMAGE
  AUDIO
  VIDEO
}

enum RouterTier {
  TIER_1
  TIER_2
  TIER_3
}

enum EnergyMeasurementSource {
  RAPL_CPU
  NVML_GPU
  OLLAMA_METRICS
  ESTIMATED_FROM_TOKENS
  ESTIMATED_FROM_DURATION
}

enum MaterialStatus {
  PROCESSING
  READY
  FAILED
}

enum ReEmbedJobStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}
