    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@react-router/dev": "^7.5.3",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
