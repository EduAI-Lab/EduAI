{
  "name": "edu-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && react-router build",
    "dev": "prisma migrate deploy && prisma generate && npm run db:seed:if-empty && react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "test:mutation": "stryker run",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:if-empty": "tsx prisma/seed-if-empty.ts",
    "db:sync-ai-providers": "tsx prisma/sync-ai-providers.ts",
    "db:seed:student-ids": "tsx prisma/seed-backfill-student-ids.ts",
    "db:seed:perf": "tsx scripts/seed-perf-volume.ts",
    "db:reset": "prisma migrate reset",
    "auth:migrate": "npx @better-auth/cli migrate",
    "auth:generate": "npx @better-auth/cli generate",
    "eval:adhd": "tsx scripts/eval-adhd-assist.mjs",
    "bench:chat": "node ./scripts/chat-latency-bench.mjs",
    "vllm:smoke": "node ./scripts/vllm-smoke.mjs",
    "research:embed-knn-exemplars": "tsx ./scripts/research/embed-knn-exemplars.ts",
    "research:eval-knn": "tsx ./scripts/research/evaluate-knn-router.ts",
    "research:eval-llm": "tsx ./scripts/research/evaluate-llm-router.ts",
    "research:verify-energy": "node ./scripts/research/verify-energy-sidecar.mjs",
    "research:backfill-energy": "node ./scripts/research/backfill-interaction-energy.mjs",
    "fleet:smoke": "node ./scripts/fleet-smoke.mjs",
    "test:embedding": "tsx scripts/test-embedding.ts",
    "re-embed:course": "tsx scripts/re-embed-course.ts",
    "eval:rag:seed": "tsx scripts/eval-rag-seed.ts",
    "eval:rag": "tsx scripts/eval-rag.ts"
  },
  "dependencies": {
