{
  "name": "edu-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && react-router build",
    "dev": "prisma migrate deploy && prisma generate && npm run db:seed:if-empty && react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:if-empty": "tsx prisma/seed-if-empty.ts",
    "db:sync-ai-providers": "tsx prisma/sync-ai-providers.ts",
    "db:reset": "prisma migrate reset",
    "auth:migrate": "npx @better-auth/cli migrate",
    "auth:generate": "npx @better-auth/cli generate",
    "eval:adhd": "node scripts/eval-adhd-assist.mjs",
    "bench:chat": "node ./scripts/chat-latency-bench.mjs",
    "vllm:smoke": "node ./scripts/vllm-smoke.mjs",
    "research:validate-suite": "node ./scripts/research/validate-task-suite.mjs",
    "research:assign-splits": "node ./scripts/research/assign-splits.mjs",
    "research:run-both-tier": "node ./scripts/research/run-both-tier-baseline.mjs",
    "research:summarize-both-tier": "node ./scripts/research/summarize-both-tier-runs.mjs",
    "research:label-both-tier": "node ./scripts/research/label-both-tier-runs.mjs",
    "research:summarize-labels": "node ./scripts/research/summarize-both-tier-labels.mjs",
    "research:run-policy": "node ./scripts/research/run-policy-comparison.mjs",
    "research:summarize-policy": "node ./scripts/research/summarize-policy-runs.mjs",
    "research:spot-check-labels": "node ./scripts/research/spot-check-hard-labels.mjs",
    "research:merge-policy-v3": "node ./scripts/research/merge-policy-v3.mjs",
    "research:run-classroom": "node ./scripts/research/run-classroom-sim.mjs",
    "research:summarize-classroom-replicates": "node ./scripts/research/summarize-classroom-replicates.mjs",
    "research:backfill-energy": "node ./scripts/research/backfill-interaction-energy.mjs",
    "research:export-human-check": "node ./scripts/research/export-human-spot-check.mjs",
    "research:build-knn-exemplars": "node ./scripts/research/build-knn-exemplars-from-labels.mjs",
    "research:eval-knn": "tsx ./scripts/research/evaluate-knn-router.ts",
    "research:eval-llm": "tsx ./scripts/research/evaluate-llm-router.ts",
    "research:status-report": "node ./scripts/research/summarize-research-status.mjs",
    "research:tier-a": "bash ./scripts/research/run-s378-tier-a.sh",
    "research:tier-continue": "bash ./scripts/research/run-s378-tier-continue.sh",
    "research:remaining": "bash ./scripts/research/run-s378-remaining-batches.sh",
    "research:offline-analysis": "bash ./scripts/research/run-offline-analysis.sh",
    "test:embedding": "tsx scripts/test-embedding.ts",
    "re-embed:course": "tsx scripts/re-embed-course.ts"
  },
