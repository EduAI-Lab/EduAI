{
  "title": "EduAI Core — k6 Load Test (#919)",
  "uid": "eduai-k6-loadtest",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Active Virtual Users",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "k6-influxdb",
      "targets": [
        {
          "rawQuery": true,
          "query": "SELECT mean(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time($__interval) fill(previous)",
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "k6-influxdb",
      "targets": [
        {
          "rawQuery": true,
          "query": "SELECT non_negative_derivative(sum(\"value\"), 1s) FROM \"http_reqs\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Request Duration (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "k6-influxdb",
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "rawQuery": true,
          "query": "SELECT mean(\"value\") AS \"avg\" FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series"
        },
        {
          "rawQuery": true,
          "query": "SELECT percentile(\"value\", 95) AS \"p95\" FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series"
        },
        {
          "rawQuery": true,
          "query": "SELECT percentile(\"value\", 99) AS \"p99\" FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "k6-influxdb",
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "rawQuery": true,
          "query": "SELECT mean(\"value\") * 100 FROM \"http_req_failed\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "Chat Stream Duration — p95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": "k6-influxdb",
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "rawQuery": true,
          "query": "SELECT percentile(\"value\", 95) FROM \"eduai_chat_stream_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "Dashboard/Page Load Duration — p95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": "k6-influxdb",
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "rawQuery": true,
          "query": "SELECT percentile(\"value\", 95) FROM \"eduai_page_load_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "Chat Success Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": "k6-influxdb",
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "rawQuery": true,
          "query": "SELECT mean(\"value\") * 100 FROM \"eduai_chat_success\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 8,
      "title": "Rate Limit 429s Triggered (cumulative)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": "k6-influxdb",
      "targets": [
        {
          "rawQuery": true,
          "query": "SELECT cumulative_sum(sum(\"value\")) FROM \"eduai_rate_limit_429s\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "resultFormat": "time_series"
        }
      ]
    }
  ]
}
