# Isolated env for the browser-level stress harness (#919).
#
# Copy to apps/core/.env.loadtest (git-ignored) and fill in BETTER_AUTH_SECRET.
# Points at a dedicated DB (eduai_loadtest) and the local mock LLM/embedding
# server in loadtest/mock-llm — never a real provider, never the shared
# dev.eduai.ok.ubc.ca host used by live study participants.

NODE_ENV="development"
PORT="4100"

DATABASE_URL="postgresql://postgres:postgres@localhost:54320/eduai_loadtest?schema=public"

BETTER_AUTH_SECRET="" # generate with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:4100"
COOKIE_DOMAIN="localhost"
# Better Auth's own rate limiter (100 req/60s, see app/lib/auth/server.ts)
# buckets by connecting IP. Every k6 VU shares one loopback IP locally, so
# leaving this on measures "how fast does the auth rate limiter trip" instead
# of actual platform capacity. Real distinct users rarely share an IP.
BETTER_AUTH_DISABLE_RATE_LIMIT="1"

EMBEDDING_PROVIDER="local"
EMBEDDING_DIMENSION="1024"
OLLAMA_BASE_URL="http://localhost:8801/"
OLLAMA_EMBEDDING_MODEL="mxbai-embed-large"

VLLM_BASE_URL="http://localhost:8801"
VLLM_API_KEY="loadtest-key"

EDUAI_API_KEY="loadtest-service-key"
ENCRYPTION_KEY="" # generate with: openssl rand -base64 32
