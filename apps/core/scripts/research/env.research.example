# Copy to apps/core/.env.research (gitignored)
# Load: set -a && source .env.research && set +a

RESEARCH_RUN_URL=http://127.0.0.1:3000/api/chat
RESEARCH_RUN_X_API_KEY=

# Prefer a JSON file — avoids shell quoting issues:
RESEARCH_RUN_API_KEYS_FILE=./scripts/research/research-api-keys.json

# Or inline (single-quote in bash when sourcing):
# RESEARCH_RUN_API_KEYS='{"vllm":{"apiKey":"vllm-local","isEnabled":true}}'

RESEARCH_RUN_OUT=/tmp/both-tier.v1.jsonl

RESEARCH_RUN_SPLIT=dev
RESEARCH_RUN_LIMIT=2
RESEARCH_RUN_SLEEP_MS=1000

# Re-run failed tier-3 tool prompts only:
# RESEARCH_RUN_IDS=ts-031,ts-032,ts-101,ts-102,ts-118
# RESEARCH_RUN_TIERS=3
# RESEARCH_RUN_TIMEOUT_MS=300000

# Step 4b — LLM judge labeling (local or CI; needs OpenAI-compatible API key)
# RESEARCH_LABEL_IN=../../docs/research/data/runs/both-tier.v1.jsonl
# RESEARCH_LABEL_OUT=../../docs/research/data/runs/labels.v1.jsonl
# RESEARCH_JUDGE_API_KEY=sk-...
# RESEARCH_JUDGE_MODEL=gpt-4o-mini
# RESEARCH_LABEL_DRY_RUN=1

# Strict re-label (full dev set) — output to a new file to avoid overwriting v1 labels:
# RESEARCH_JUDGE_VIA_EDUAI=1
# RESEARCH_JUDGE_STRICT=1
# RESEARCH_LABEL_OUT=../../docs/research/data/runs/labels-strict.v1.jsonl

# Energy sidecar — on by default for research scripts (set RESEARCH_MEASURE_ENERGY=0 to skip)
ENERGY_SIDECAR_URL=http://127.0.0.1:9100
# RESEARCH_MEASURE_ENERGY=0
# RESEARCH_REPLICATE=3
# RESEARCH_ENERGY_SETTLE_MS=5000
# RESEARCH_RUN_SPLIT=test
# RESEARCH_POLICY=both
# RESEARCH_RUN_LABEL=policy-energy-v1
# RESEARCH_POLICY_OUT=../../docs/research/data/runs/policy-runs-test.energy.v1.jsonl

# Backfill token energy from AIInteraction (on s378 with DATABASE_URL):
# RESEARCH_BACKFILL_IN=../../docs/research/data/runs/policy-runs-test.v3.jsonl
# RESEARCH_BACKFILL_SINCE=2026-06-09T00:00:00Z
# RESEARCH_BACKFILL_UNTIL=2026-06-11T00:00:00Z

# Human judge validation worksheet:
# npm run research:export-human-check

# Unattended batches (s378 / cmps01):
# npm run research:tier-a          # P1 dev + summarize + human worksheet → /tmp/
# bash scripts/research/run-cmps01-energy-batch.sh
# npm run research:offline-analysis   # labels + kNN + status report (no API)
# npm run research:status-report
# cp scripts/research/env.research.s378.example .env.research  # on s378
#
# Policy runs:
#   RESEARCH_POLICY=P1   model=auto      (rules)
#   RESEARCH_POLICY=P3b  model=auto-llm  (LLM classifier)
#   RESEARCH_POLICY=all  P0 + P1 + P3b
