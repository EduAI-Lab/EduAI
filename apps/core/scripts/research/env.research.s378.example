# Copy to apps/core/.env.research on s378 (gitignored).
# Load automatically by run-s378-tier-a.sh and run-offline-analysis.sh.
#
#   cp scripts/research/env.research.s378.example .env.research
#   # edit secrets, then:
#   set -a && source .env.research && set +a

# Chat API (dev app on same host)
RESEARCH_RUN_URL=http://127.0.0.1:3000/api/chat
# Cookie from browser login (preferred for batch runs on s378):
RESEARCH_RUN_COOKIE=
# Fallback only — Bearer EDUAI_API_KEY breaks chat persistence (service user id):
# RESEARCH_RUN_X_API_KEY=

# Default course when task-suite row has course_code=null (quote if code has spaces)
RESEARCH_DEFAULT_COURSE_CODE="COSC 101"

# API keys for vLLM (file avoids shell quoting issues; write real VLLM_API_KEY on s378)
RESEARCH_RUN_API_KEYS_FILE=./scripts/research/research-api-keys.json

# URA research data
RESEARCH_RUNS_DIR=/srv/www/dev.eduai.ok.ubc.ca/EduAICore/docs/research/data/runs
RESEARCH_SUITE_DIR=./scripts/research/data/task-suite

# Labels for oracle-gap summarize
RESEARCH_LABEL_OUT=/srv/www/dev.eduai.ok.ubc.ca/EduAICore/docs/research/data/runs/labels.v1.jsonl
RESEARCH_HUMAN_CHECK_IN=/srv/www/dev.eduai.ok.ubc.ca/EduAICore/docs/research/data/runs/both-tier.v1.jsonl

# Tier A batch outputs (override if needed)
RESEARCH_POLICY_OUT=/tmp/policy-runs-p1-dev.jsonl
RESEARCH_TIER_A_SUMMARY=/tmp/policy-runs-p1-dev-summary.txt
RESEARCH_HUMAN_CHECK_OUT=/tmp/human-spot-check.md

# Pacing
RESEARCH_RUN_SLEEP_MS=500

# Energy sidecar via cmps01 :8001 reverse proxy (no extra firewall port)
ENERGY_SIDECAR_URL=http://cmps01.ok.ubc.ca:8001/energy
# RESEARCH_MEASURE_ENERGY=0
# ENERGY_METER_DIR=/srv/www/.../tools/energy-meter  # s378 only; cmps01 uses Docker

# Offline kNN (laptop or s378 with embed API)
# ROUTING_KNN_EXEMPLARS_PATH=./data/routing-knn-exemplars.json
# RESEARCH_KNN_LEAVE_ONE_OUT=1
