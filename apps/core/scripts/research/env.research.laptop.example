# Laptop / remote API runs (no s378 SSH). Copy to apps/core/.env.research (gitignored).
#
#   cp scripts/research/env.research.laptop.example .env.research
#   . ./scripts/research/load-research-env.ps1

# Live dev stack (RAG + indexed materials)
RESEARCH_RUN_URL=https://dev.eduai.ok.ubc.ca/api/chat

# Admin auth — pick ONE (EDUAI_API_KEY is the service Bearer key, not x-api-key):
# RESEARCH_RUN_X_API_KEY=   # better-auth admin API key from dev Settings → API Keys
# Or save one line to apps/core/.env.research.cookie (gitignored), e.g.:
#   better-auth.session_token=<value from DevTools → Application → Cookies>
# RESEARCH_RUN_COOKIE_FILE=./.env.research.cookie

# OpenRouter chat via openai-compatible provider (see providers.ts baseUrl)
RESEARCH_RUN_API_KEYS_FILE=./scripts/research/research-api-keys.openrouter.json
RESEARCH_FIXED_MODEL=openai:google/gemini-2.5-flash

RESEARCH_RUN_SPLIT=dev
RESEARCH_RUN_SLEEP_MS=500
RESEARCH_MEASURE_ENERGY=0
RESEARCH_RUNS_DIR=../../docs/research/data/runs/issue-501-laptop
RESEARCH_PIPELINE_LABEL=laptop-openrouter

# Smoke test: RESEARCH_RUN_LIMIT=3
