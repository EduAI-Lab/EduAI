# Main-baseline runs against my.eduai (s348) — currently deploys `main`.
# Copy to apps/core/.env.research and add cookie or admin API key.
#
#   cp scripts/research/env.research.my.example .env.research

RESEARCH_RUN_URL=https://my.eduai.ok.ubc.ca/api/chat
RESEARCH_RUN_API_KEYS_FILE=./scripts/research/research-api-keys.openrouter.json
RESEARCH_FIXED_MODEL=openai:google/gemini-2.5-flash
RESEARCH_RUN_SPLIT=dev
RESEARCH_RUN_SLEEP_MS=500
RESEARCH_MEASURE_ENERGY=0
RESEARCH_RUNS_DIR=../../docs/research/data/runs/issue-501-my-main
RESEARCH_PIPELINE_LABEL=main-baseline
RESEARCH_RUN_LABEL=501-my-main

# Auth: RESEARCH_RUN_X_API_KEY or save session to apps/core/.env.research.cookie
# RESEARCH_RUN_COOKIE_FILE=./.env.research.cookie
