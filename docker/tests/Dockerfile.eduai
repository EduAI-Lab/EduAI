# EduAI Core
# Targets:
#   test  — Vitest runner (unit and integration suites)
#   serve — react-router-serve for E2E (SSR, runs prisma migrate deploy at startup)
#
# Build context: monorepo root

# ── Shared: install workspace dependencies ─────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json .npmrc ./
COPY apps/core/package.json                                   ./apps/core/
COPY apps/extensions/ai-tutor/package.json                    ./apps/extensions/ai-tutor/
COPY apps/extensions/ai-tutor/server/package.json             ./apps/extensions/ai-tutor/server/
COPY apps/extensions/question-maker/package.json              ./apps/extensions/question-maker/
COPY apps/extensions/question-maker/app/backend/package.json  ./apps/extensions/question-maker/app/backend/
COPY apps/extensions/question-maker/app/frontend/package.json ./apps/extensions/question-maker/app/frontend/

RUN npm ci --ignore-scripts

# ── Target: test ───────────────────────────────────────────────────────────
FROM node:20-alpine AS test
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules

COPY apps/core/app               ./apps/core/app
COPY apps/core/prisma            ./apps/core/prisma
COPY apps/core/vitest.config.ts  ./apps/core/
COPY apps/core/vite.config.ts    ./apps/core/
COPY apps/core/react-router.config.ts ./apps/core/
COPY apps/core/tsconfig.json     ./apps/core/
COPY apps/core/package.json      ./apps/core/

ENV PATH="/app/node_modules/.bin:${PATH}"

RUN npx prisma generate --schema=apps/core/prisma/schema.prisma

WORKDIR /app/apps/core
CMD ["npx", "vitest", "run"]

# ── Build: compile for production serve ────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY apps/core ./apps/core

ENV PATH="/app/node_modules/.bin:${PATH}"
# prisma generate does not connect to the DB; placeholder prevents any env check
ENV DATABASE_URL=postgresql://build:build@build:5432/build

WORKDIR /app/apps/core
RUN npm run build

# ── Target: serve ──────────────────────────────────────────────────────────
FROM node:20-alpine AS serve
WORKDIR /app

COPY --from=deps /app/node_modules            ./node_modules
COPY --from=build /app/apps/core/build        ./apps/core/build
COPY --from=build /app/apps/core/node_modules ./apps/core/node_modules
COPY --from=build /app/apps/core/prisma       ./apps/core/prisma
COPY apps/core/package.json                   ./apps/core/

ENV PATH="/app/node_modules/.bin:${PATH}"

WORKDIR /app/apps/core
CMD ["sh", "-c", "npx prisma migrate deploy && npm run start"]