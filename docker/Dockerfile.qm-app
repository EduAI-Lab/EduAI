# Question Maker frontend (Vite/React SPA)
# Target:
#   serve — vite preview for E2E
#
# Build context: monorepo root
#
# Must build from the repo root because the frontend declares
# "question-maker-backend": "*" as a workspace dependency.

# ── Shared: install workspace dependencies ─────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json .npmrc ./
COPY apps/core/package.json                                   ./apps/core/
COPY apps/extensions/ai-tutor/package.json                    ./apps/extensions/ai-tutor/
COPY apps/extensions/ai-tutor/server/package.json             ./apps/extensions/ai-tutor/server/
COPY apps/extensions/question-maker/package.json              ./apps/extensions/question-maker/
COPY apps/extensions/question-maker/app/backend/package.json  ./apps/extensions/question-maker/app/backend/
COPY apps/extensions/question-maker/app/frontend/package.json ./apps/extensions/question-maker/app/frontend/

RUN npm ci --ignore-scripts

# ── Target: test ───────────────────────────────────────────────────────────
FROM node:20-alpine AS test
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/extensions/question-maker/node_modules \
     ./apps/extensions/question-maker/node_modules

# Backend stub required for workspace symlink resolution
COPY apps/extensions/question-maker/app/backend/src \
     ./apps/extensions/question-maker/app/backend/src
COPY apps/extensions/question-maker/app/backend/package.json \
     ./apps/extensions/question-maker/app/backend/

COPY apps/extensions/question-maker/app/frontend/src \
     ./apps/extensions/question-maker/app/frontend/src
COPY apps/extensions/question-maker/app/frontend/vite.config.ts \
     ./apps/extensions/question-maker/app/frontend/
COPY apps/extensions/question-maker/app/frontend/tsconfig.json \
     ./apps/extensions/question-maker/app/frontend/
COPY apps/extensions/question-maker/app/frontend/tsconfig.node.json \
     ./apps/extensions/question-maker/app/frontend/
COPY apps/extensions/question-maker/app/frontend/index.html \
     ./apps/extensions/question-maker/app/frontend/
COPY apps/extensions/question-maker/app/frontend/package.json \
     ./apps/extensions/question-maker/app/frontend/

ENV PATH="/app/apps/extensions/question-maker/node_modules/.bin:/app/node_modules/.bin:${PATH}"

WORKDIR /app/apps/extensions/question-maker/app/frontend
CMD ["sh", "-c", "../../node_modules/.bin/vitest run"]

# ── Build ──────────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules

COPY apps/extensions/question-maker/app/backend/src \
     ./apps/extensions/question-maker/app/backend/src
COPY apps/extensions/question-maker/app/backend/package.json \
     ./apps/extensions/question-maker/app/backend/

COPY apps/extensions/question-maker/app/frontend \
     ./apps/extensions/question-maker/app/frontend

ENV PATH="/app/node_modules/.bin:${PATH}"

WORKDIR /app/apps/extensions/question-maker/app/frontend
RUN npm run build

# ── Target: serve ──────────────────────────────────────────────────────────
FROM node:20-alpine AS serve
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/apps/extensions/question-maker/app/frontend/dist \
     ./apps/extensions/question-maker/app/frontend/dist
COPY apps/extensions/question-maker/app/frontend/package.json \
     ./apps/extensions/question-maker/app/frontend/
COPY apps/extensions/question-maker/app/frontend/vite.config.ts \
     ./apps/extensions/question-maker/app/frontend/

ENV PATH="/app/node_modules/.bin:${PATH}"

WORKDIR /app/apps/extensions/question-maker/app/frontend
CMD ["sh", "-c", "npx vite preview --port ${PORT:-5173} --host 0.0.0.0"]