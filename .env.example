# Copy to `.env` at the monorepo root. Used by `docker-compose.dev.yml` for port overrides.
#
# Core / Tutor: user `postgres`, password `postgres`.
# Question Maker: user `postgres`, password `password` (matches `apps/extensions/question-maker/.env.example`).

CORE_DB_PORT=54320
TUTOR_DB_PORT=54321
QM_DB_PORT=55432

# Redis (Core async AI-job queue — BullMQ). Host port override for the dev stack.
CORE_REDIS_PORT=63790
