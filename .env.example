# ╔═══════════════════════════════════════════════════════════════════════╗
# ║  EduAI Platform — Root Environment Variables                        ║
# ║                                                                     ║
# ║  Copy this file to .env and fill in the values.                     ║
# ║  These are used by docker-compose.dev.yml and docker-compose.prod.yml.║
# ║  Each app also has its own .env — see the per-app .env.example.     ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ── Database Ports (docker-compose.dev.yml) ───────────────────────────
# Override these if the defaults conflict with services on your machine.
CORE_DB_PORT=5432
TUTOR_DB_PORT=54321
QM_DB_PORT=55432

# ── Dev App Ports (docker-compose.dev.yml) ────────────────────────────
CORE_PORT=5174
TUTOR_FE_PORT=5173
TUTOR_BE_PORT=4000
QM_FE_PORT=5176
QM_BE_PORT=8000

# ── Production App Ports (docker-compose.prod.yml) ────────────────────
# These use the same variable names so you only need one .env.
# Override per-environment as needed.
# CORE_PORT=3000
# TUTOR_FE_PORT=3001
# TUTOR_BE_PORT=4000
# QM_BE_PORT=8000
# QM_FE_PORT=3005
