# docs/PICT_CENSUS.md § S5 — ssrf-ipv6-classify (QM canvasUrlGuard.js isPrivateIPv6)
AddressForm:     loopback, link-local, unique-local, global, ipv4-mapped, unspecified
ZoneId:          none, present
Bracketed:       yes, no
MappedEncoding:  dotted, hex

IF [AddressForm] <> "ipv4-mapped" THEN [MappedEncoding] = "dotted";
IF [AddressForm] = "ipv4-mapped" THEN [ZoneId] = "none";
IF [ZoneId] = "present" THEN [AddressForm] in {"link-local", "global"};
IF [ZoneId] = "present" THEN [Bracketed] = "yes";
