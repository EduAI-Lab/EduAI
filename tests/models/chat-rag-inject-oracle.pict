# docs/PICT_CENSUS.md § S3 — chat-rag-inject-oracle
# Information-exposure gate: whether retrieved course material may enter the chat
# system prompt (course-rag-policy.ts shouldInjectCourseRag). Material visibility
# at retrieval is covered by #1180 — this model covers inject-on-top only.
HasCourse:         yes, no
AlwaysWithCourse:  yes, no
CourseRagNeeded:   yes, no
TopSimilarity:     none, weak, moderate, strong

IF [HasCourse] = "no" THEN [AlwaysWithCourse] = "no";
IF [HasCourse] = "no" THEN [CourseRagNeeded] = "no";
IF [HasCourse] = "no" THEN [TopSimilarity] = "none";
IF [AlwaysWithCourse] = "yes" THEN [HasCourse] = "yes";
IF [CourseRagNeeded] = "yes" THEN [HasCourse] = "yes";
