# docs/PICT_CENSUS.md § S5 — parse-validate-canvas-url (Core ∪ QM drift)
# Core parseAndValidateCanvasUrl vs QM validateCanvasUrl at connect/parse time.
UrlShape:     https-host, http-host, with-userinfo, relative, opaque
HostClass:    public-dns, localhost, ipv4-private, ipv4-public, ipv6-literal
ExtraPath:    none, traversal, query-ssrf

IF [UrlShape] in {"relative", "opaque", "with-userinfo"} THEN [HostClass] = "public-dns";
IF [UrlShape] = "http-host" THEN [HostClass] <> "ipv6-literal";
IF [HostClass] = "ipv6-literal" THEN [UrlShape] = "https-host";
IF [UrlShape] in {"relative", "opaque"} THEN [ExtraPath] = "none";
