# docs/PICT_CENSUS.md § S4 — import-reconcile
# Canvas file import into Core course materials (importSingleCanvasFile).
Excluded:          yes, no
CanvasPublished:   yes, no
ExistingPresent:   yes, no
DeletedAt:         yes, no
StaleAndReady:     yes, no
ChecksumDup:       yes, no

IF [ExistingPresent] = "no" THEN [DeletedAt] = "no";
IF [ExistingPresent] = "no" THEN [StaleAndReady] = "no";
IF [ExistingPresent] = "no" THEN [ChecksumDup] = "no";
IF [DeletedAt] = "yes" THEN [StaleAndReady] = "no";
IF [DeletedAt] = "yes" THEN [ChecksumDup] = "no";
IF [StaleAndReady] = "yes" THEN [ChecksumDup] = "no";
