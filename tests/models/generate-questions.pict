# S9 — generate-questions (QM), census docs/PICT_CENSUS.md § S9.
# See tests/models/generate-questions.oracle.ts for the oracle spec.
#
# POST /api/eduai/generate-questions
# (apps/extensions/question-maker/app/backend/src/routes/eduai.js).
# Checks run in this order: authentication -> prompt required -> courseId OR
# courseCode required (#1362) -> numQuestions vs config.maxQuestions ->
# content-aware course access. `Authorized` preserves platform-role coverage,
# but does not gate this route because Core represents TAs as STUDENT.
# Course access uses courseId via resolveCourseAccessWithCourse, else courseCode via
# resolveCourseCodeAccess; both-present prefers courseId; TA-rank+) ->
# proxy to eduaiService.generateQuestions.
# `Mcq`/`DifficultyDistribution`/`ReasoningDistribution` don't gate the
# response at all — they only change what gets forwarded downstream — so
# this model also asserts the forwarded payload on every 200 row, not just
# the status code.
Authorized:              yes, no
PromptPresent:           yes, no
CourseIdPresent:         yes, no
CourseCodePresent:       yes, no
NumQuestions:            absent, valid, exceeds
CourseAccess:            yes, no
Mcq:                     absent, valid, low, high
DifficultyDistribution:  provided, absent
ReasoningDistribution:   provided, absent
